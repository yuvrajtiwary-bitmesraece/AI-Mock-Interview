# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local        (macOS / Linux)
#   copy .env.example .env.local      (Windows)
#
# IMPORTANT: Anything prefixed with NEXT_PUBLIC_ is bundled into the JavaScript
# sent to the browser. Never put secrets in a NEXT_PUBLIC_ variable.

# --- Clerk authentication (https://dashboard.clerk.com -> API keys) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Server-only secrets ------------------------------------------------------
# Neon Postgres connection string (https://console.neon.tech -> Connect)
DATABASE_URL=

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- Optional -----------------------------------------------------------------
# Number of questions generated per interview (1-10). Defaults to 5.
# INTERVIEW_QUESTION_COUNT=5

# Gemini models to try, in order. If one is overloaded, rate-limited or retired,
# the next is used. Defaults to gemini-3.5-flash-lite,gemini-2.5-flash,gemini-3.1-flash-lite
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash

# Gemini models for transcribing voice answers, tried in order.
# Defaults to gemini-3.5-transcribe,gemini-3.5-flash-lite,gemini-2.5-flash
# GEMINI_TRANSCRIBE_MODELS=gemini-3.5-transcribe,gemini-3.5-flash-lite

# Daily AI limits per user (reset at midnight UTC). Set to 0 for no limit.
# AI_DAILY_LIMIT_INTERVIEWS=10
# AI_DAILY_LIMIT_ANSWERS=100
# AI_DAILY_LIMIT_REPORTS=30
# AI_DAILY_LIMIT_TRANSCRIPTIONS=300

# Public URL of your deployment, used in link previews and the sitemap.
# Only needed with a custom domain; Vercel URLs are detected automatically.
# NEXT_PUBLIC_SITE_URL=https://interview.example.com
