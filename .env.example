# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local        (macOS / Linux)
#   copy .env.example .env.local      (Windows)
#
# IMPORTANT: Anything prefixed with NEXT_PUBLIC_ is bundled into the JavaScript
# sent to the browser. Never put secrets in a NEXT_PUBLIC_ variable.

# --- Clerk authentication (https://dashboard.clerk.com -> API keys) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Server-only secrets ------------------------------------------------------
# Neon Postgres connection string (https://console.neon.tech -> Connect)
DATABASE_URL=

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- Optional -----------------------------------------------------------------
# Number of questions generated per interview (1-10). Defaults to 5.
# INTERVIEW_QUESTION_COUNT=5
